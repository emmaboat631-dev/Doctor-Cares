# Doctor Cares environment configuration
#
# Copy this file to .env and fill in the values from your Supabase project.
# NEVER commit .env or the service-role key to source control.

# Public Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (safe to expose in the browser — RLS enforces access)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: your production URL — used for password-reset redirect links
VITE_APP_URL=http://localhost:5173

# Admin accounts are provisioned server-side via the `promote_to_admin` RPC
# (see supabase/migrations/0008_admin_bootstrap.sql). There is no client-side
# admin allowlist — placing emails in `VITE_*` would leak them into the public
# bundle.

# VAPID public key for Web Push (iOS PWA + desktop browsers).
# Generate once with: npx web-push generate-vapid-keys
# Only the PUBLIC key is safe for the client. The matching private key lives
# as a Supabase secret used by the send-push Edge Function.
VITE_VAPID_PUBLIC_KEY=
